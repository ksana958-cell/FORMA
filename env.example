# Set values as environment variables in the BotHost dashboard (not in GitHub)
BOT_TOKEN=SET_YOUR_BOTFATHER_TOKEN
OWNER_TELEGRAM_ID=SET_YOUR_NUMERIC_TELEGRAM_ID
WEBHOOK_SECRET=SET_A_RANDOM_32_CHARACTER_SECRET
PUBLIC_BASE_URL=https://YOUR_HOSTNAME.bothost.tech
OFF_CONTACT=your-public-contact-email@example.com
# Optional paid vision API:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# BotHost automatically provides PORT. DATA_DIR defaults to /app/data in Docker.
# For local development: DATA_DIR=./data PORT=3000
